# Copy to .env.local and fill in. All VITE_* vars are baked into the build.

# Notion notes proxy (existing) — see worker/notion-proxy.js
VITE_NOTION_PROXY_URL=https://notion-proxy.YOUR_SUBDOMAIN.workers.dev

# Cloud progress sync (Cloudflare Worker + KV) — see worker/progress-sync.js + wrangler.toml
# The URL is your deployed progress-sync Worker.
VITE_SYNC_URL=https://deutschmeister-progress-sync.YOUR_SUBDOMAIN.workers.dev
# A secret sync key that is also listed in the Worker's SYNC_KEYS secret.
# This is your login-free identity — treat it like a password. Anyone with it
# can read/write your progress, but nothing else.
VITE_SYNC_KEY=choose-a-long-random-string
